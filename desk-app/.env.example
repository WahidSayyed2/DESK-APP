# Supabase — from Project Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Google Gemini — free tier, no credit card required
# Get a key at https://aistudio.google.com/apikey
# Server-side only. Never exposed to the browser.
GEMINI_API_KEY=your-gemini-api-key

# Supabase Service Role key — from Project Settings > API > service_role
# Only used server-side in /api/admin/create-user to let the Super Admin
# create new logins. NEVER exposed to the browser, never used client-side.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
